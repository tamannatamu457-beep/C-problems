#include <stdio.h>

int main(){
    char s1[100], s2[100];
    int i=0;
    scanf("%s %s", s1, s2);
    while(s1[i] && s2[i]){
        if(s1[i]<s2[i]){
printf("First smaller"); 
return 0;
}
        if(s1[i]>s2[i]){
printf("First greater"); 
return 0;
}
        i++;
    }
    if(!s1[i] && !s2[i]) 
printf("Equal");
    else if(!s1[i]) 
printf("First smaller");
    else 
printf("First greater");
return 0;
}
