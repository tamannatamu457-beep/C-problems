#include <stdio.h>

int isPrime(int n) {
    int i;
    if (n < 2)
        return 0;

    for(i = 2; i < n; i++) {
        if (n % i == 0)
            return 0;
    }
    return 1;
}

void showPrimes(int a, int b) {
    int i;
    for(i = a; i <= b; i++) {
        if(isPrime(i))
            printf("%d ", i);
    }
}

int main() {
    int lower, upper;

    printf("Enter lower interval: ");
    scanf("%d", &lower);

    printf("Enter upper interval: ");
    scanf("%d", &upper);

    printf("Prime numbers between %d and %d are:\n", lower, upper);
    showPrimes(lower, upper);

    return 0;
}
